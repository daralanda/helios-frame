# ==========================================================================
# Helios Frame · Apache (GoDaddy cPanel / Linux paylaşımlı hosting)
# Windows / Plesk (IIS) hostingde bunun yerine web.config kullanılır.
# Güvenlik başlıklarının tek kaynağı tools/headers.mjs dosyasıdır; değiştirirseniz
# burayı ve web.config'i de güncelleyin (npm test farkı yakalar).
# ==========================================================================

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_mime.c>
  AddType text/javascript .js .mjs
  AddType application/json .json
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
  AddType image/avif .avif
  AddType image/webp .webp
  AddDefaultCharset utf-8
  AddCharset utf-8 .js .css .json .svg .xml .txt
</IfModule>

# ---- HTTPS'e zorla ----
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Geliştirme dosyalarını dışarıya kapat (yanlışlıkla yüklenirse)
  RewriteRule ^(tests|tools|node_modules|\.github)(/|$) - [R=404,L]
  RewriteRule ^(package(-lock)?\.json|README\.md)$ - [R=404,L]
</IfModule>

# ---- Gizli dosyalar (.git, .env, .htaccess ...) ----
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# ---- Güvenlik başlıkları ----
<IfModule mod_headers.c>
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests; require-trusted-types-for 'script'; trusted-types helios"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(self), usb=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set X-Frame-Options "DENY"
  Header unset X-Powered-By
  Header unset Server
</IfModule>

# ---- Sıkıştırma ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/xml text/plain
</IfModule>

# ---- Önbellek ----
# Derleme/hash olmadığından JS/CSS kısa süre önbellekte tutulur ve "no-cache" ile her istekte
# ETag doğrulanır (304). Font ve görseller uzun süre önbellekte kalır.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/javascript "access plus 1 hour"
  ExpiresByType text/css "access plus 1 hour"
  ExpiresByType application/json "access plus 5 minutes"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/avif "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
