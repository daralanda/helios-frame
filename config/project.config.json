{
  "$comment": "Projeye özel ayarlar. Tüm alanlar ve açıklamaları için README > Yeni proje kurulumu. Örnek dolu bir yapılandırma: examples/config/project.config.json",
  "name": "helios-app",
  "locale": "tr-TR",
  "currency": "TRY",
  "timezone": "Europe/Istanbul",

  "brand": { "name": "Helios Diji", "logo": "assets/img/logo.svg", "home": "./" },

  "theme": {
    "mode": "auto",
    "density": "comfortable",
    "colors": { "brand": "#f47b20", "accent": "#383e42" },
    "radius": "10px"
  },

  "layout": {
    "width": "full",
    "nav": "horizontal",
    "collapsible": true,
    "search": false,
    "themeToggle": true,
    "footer": true
  },

  "menu": "config/menu.json",

  "api": { "baseURL": "/api/" },
  "auth": { "meEndpoint": null, "loginUrl": null, "logoutUrl": null },

  "footer": { "copyright": "Helios Diji", "links": [] },

  "seo": {
    "siteUrl": "https://heliosdiji.com",
    "siteName": "Helios Diji",
    "titleTemplate": "%s · Helios Diji",
    "description": "Helios Frame ile hazırlanmış site."
  }
}
